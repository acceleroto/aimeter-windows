<Window x:Class="AIMeter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIMeter settings" Width="520" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,4,20,20">
        <TextBlock Text="Providers" Style="{StaticResource Heading}" />
        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Connected providers appear in the overlay. Signing in happens in a browser window that stays on this PC." />
        <StackPanel x:Name="ProviderRows" />

        <TextBlock Text="Overlay" Style="{StaticResource Heading}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="44" Maximum="120" TickFrequency="2"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock x:Name="SizeText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
            <TextBlock Grid.Row="1" Text="Opacity" VerticalAlignment="Center" Margin="0,8,0,0" />
            <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="5"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="OpacityText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       TextAlignment="Right" Margin="0,8,0,0" />
        </Grid>
        <CheckBox x:Name="DarkEdgeBox" Content="Thin dark edge (keeps it readable over light windows)" Margin="0,10,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <CheckBox x:Name="ColorBox" Content="Color by usage: amber at" VerticalAlignment="Center" Margin="0" />
            <TextBox x:Name="AmberBox" Width="36" Margin="6,0,2,0" TextAlignment="Right" />
            <TextBlock Text="%, red at" VerticalAlignment="Center" Margin="2,0,6,0" />
            <TextBox x:Name="RedBox" Width="36" TextAlignment="Right" />
            <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" />
        </StackPanel>
        <Button x:Name="MoveButton" Content="Move overlay" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Move_Click" />

        <TextBlock Text="General" Style="{StaticResource Heading}" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Refresh every" VerticalAlignment="Center" />
            <ComboBox x:Name="RefreshBox" Width="90" Margin="8,0">
                <ComboBoxItem Content="1 min" Tag="1" />
                <ComboBoxItem Content="2 min" Tag="2" />
                <ComboBoxItem Content="5 min" Tag="5" />
                <ComboBoxItem Content="10 min" Tag="10" />
                <ComboBoxItem Content="15 min" Tag="15" />
                <ComboBoxItem Content="30 min" Tag="30" />
            </ComboBox>
            <Button Content="Refresh now" Click="Refresh_Click" />
        </StackPanel>
        <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,10,0,0" />
    </StackPanel>
</Window>
