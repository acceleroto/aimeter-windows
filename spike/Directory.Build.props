<Project>
  <!-- Keep build output out of Dropbox. -->
  <PropertyGroup>
    <AIMeterBuildRoot>$(LOCALAPPDATA)\AIMeterWin\build\$(MSBuildProjectName)\</AIMeterBuildRoot>
    <BaseOutputPath>$(AIMeterBuildRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(AIMeterBuildRoot)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
