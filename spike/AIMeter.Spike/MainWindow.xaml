<Window x:Class="AIMeter.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIMeter spike — WebView2 usage capture" Width="900" Height="640">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                1. Click "Sign in" for each provider and sign in. When the usage page appears, close that window.
                2. Click "Test all in background". It loads each usage page in a hidden window and tries to read the numbers.
            </TextBlock>
            <StackPanel x:Name="ProviderRows" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button x:Name="TestAllButton" Content="Test all in background" Padding="10,4" Click="TestAll_Click" />
                <Button Content="Open captures folder" Padding="10,4" Margin="8,0,0,0" Click="OpenCaptures_Click" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
